PORT=3000
# Required to read the list: GET /api/subscribers?key=YOUR_ADMIN_KEY
ADMIN_KEY=change-me-to-a-long-random-string
# Optional: path of the file where emails are stored
DATA_FILE=./data/subscribers.json

# ---- M-Pesa STK Push (Daraja) ----
MPESA_ENV=sandbox                      # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379                 # sandbox test code; use your Paybill/Till shortcode in production
MPESA_PASSKEY=                         # Lipa na M-Pesa Online passkey (from the Daraja portal)
MPESA_TXN_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for a Till
MPESA_PARTYB=                          # Buy Goods only: your Till number
MPESA_CALLBACK_BASE=https://your-public-domain.com   # must be public HTTPS (use ngrok when testing)
MPESA_CALLBACK_SECRET=                 # long random string, becomes part of the callback URL
TICKET_PRICE_KES=100
